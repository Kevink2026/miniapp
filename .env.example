# WalletConnect Project ID (get from https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# BaseScan API Key (get from https://basescan.org/apis)
NEXT_PUBLIC_BASESCAN_API_KEY=your_basescan_api_key_here

# NFT Contract Address (after deployment)
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# App URL (your deployed URL)
NEXT_PUBLIC_URL=https://your-app.vercel.app

# OnchainKit API Key (get from https://portal.cdp.coinbase.com/)
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_onchainkit_api_key

# CDP Node RPC URL (get from https://portal.cdp.coinbase.com/ → Data → Node)
CDP_NODE_URL=https://api.developer.coinbase.com/rpc/v1/base/YOUR_KEY_HERE

# Farcaster Account Association (for manifest signing)
# Generate these using the OnchainKit CLI
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=
